# Portable Git defaults. Secrets and authentication tokens do not belong here.

[alias]
	co = checkout
	sw = switch
	br = branch
	ci = commit
	# Personal, explicitly signed commit. Ordinary/agent commits remain unattended.
	cis = commit -S
	st = status
[init]
	defaultBranch = main
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
	followTags = true        # Push annotated tags that point to pushed commits
[fetch]
	prune = true             # Remove stale remote-tracking branches on fetch
	pruneTags = true         # Prune deleted remote tags on fetch
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output
[core]
	pager = tokyo-night-delta
[interactive]
	diffFilter = tokyo-night-delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[commit]
	verbose = true           # Include diff comment in commit message template
	gpgSign = false
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically
[user]
	name = Mark Groves
	email = mark@grovr.au
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAID+7IIgzSsQxb6Vys3v9d724lhaYnmnYXNQxsu5yHoDI
