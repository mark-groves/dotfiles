#!/usr/bin/env bash
set -euo pipefail

internal_monitor="${INTERNAL_MONITOR:-eDP-2}"
output_file="${WORKSPACE_PROFILE_FILE:-$HOME/.config/hypr/workspaces.active.conf}"

active_monitors_json() {
  hyprctl -j monitors
}

first_active_external() {
  jq -r --arg internal "$internal_monitor" \
    '[.[] | select(.disabled == false and .name != $internal) | .name][0] // ""'
}

active_internal() {
  jq -r --arg internal "$internal_monitor" \
    '[.[] | select(.disabled == false and .name == $internal) | .name][0] // ""'
}

workspace_rule() {
  local workspace="$1"
  local monitor="$2"
  local default="${3:-false}"
  local args=""

  if [[ -n "$monitor" ]]; then
    args=", monitor:${monitor}"
  fi

  if [[ "$default" == "true" ]]; then
    args="${args}, default:true"
  fi

  printf 'workspace = %s%s, persistent:true\n' "$workspace" "$args"
}

write_all_to_monitor() {
  local monitor="$1"

  for workspace in {1..9}; do
    if [[ "$workspace" == "1" ]]; then
      workspace_rule "$workspace" "$monitor" true
    else
      workspace_rule "$workspace" "$monitor"
    fi
  done
}

write_split_profile() {
  local external="$1"
  local internal="$2"

  for workspace in {1..6}; do
    if [[ "$workspace" == "1" ]]; then
      workspace_rule "$workspace" "$external" true
    else
      workspace_rule "$workspace" "$external"
    fi
  done

  for workspace in {7..9}; do
    if [[ "$workspace" == "7" ]]; then
      workspace_rule "$workspace" "$internal" true
    else
      workspace_rule "$workspace" "$internal"
    fi
  done
}

apply_profile() {
  command -v jq >/dev/null

  local monitors_json external internal primary tmp
  monitors_json="$(active_monitors_json)"
  external="$(first_active_external <<<"$monitors_json")"
  internal="$(active_internal <<<"$monitors_json")"
  primary="${external:-$internal}"

  mkdir -p "$(dirname "$output_file")"
  tmp="$(mktemp "${output_file}.XXXXXX")"

  {
    printf '# Generated by ~/.config/hypr/scripts/workspace-monitor-profile\n'
    printf '# Edit that script, not this file.\n\n'

    if [[ -n "$external" && -n "$internal" ]]; then
      printf '# Docked profile: primary workspaces on %s, laptop workspaces on %s.\n' "$external" "$internal"
      write_split_profile "$external" "$internal"
    else
      printf '# Single-display profile: all workspaces on %s.\n' "${primary:-Hyprland default monitor}"
      write_all_to_monitor "$primary"
    fi
  } >"$tmp"

  if [[ ! -f "$output_file" ]] || ! cmp -s "$tmp" "$output_file"; then
    mv "$tmp" "$output_file"
    hyprctl reload >/dev/null
  else
    rm "$tmp"
  fi
}

watch_profile() {
  local runtime_dir socket lock
  runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"
  socket="${runtime_dir}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:?HYPRLAND_INSTANCE_SIGNATURE is not set}/.socket2.sock"
  lock="${runtime_dir}/hypr-workspace-monitor-profile.lock"

  exec 9>"$lock"
  flock -n 9 || exit 0

  apply_profile

  socat -U - "UNIX-CONNECT:${socket}" | while IFS= read -r event; do
    case "$event" in
      monitoradded*|monitorremoved*)
        sleep 0.5
        apply_profile
        ;;
    esac
  done
}

case "${1:-apply}" in
  apply)
    apply_profile
    ;;
  watch)
    watch_profile
    ;;
  *)
    printf 'Usage: %s [apply|watch]\n' "$0" >&2
    exit 2
    ;;
esac
